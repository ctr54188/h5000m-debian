[Unit]
Description=H5000M Access Point on %i
After=h5000m-wifi-vif.service sys-subsystem-net-devices-%i.device
Requires=h5000m-wifi-vif.service
BindsTo=sys-subsystem-net-devices-%i.device

[Service]
Type=forking
PIDFile=/run/hostapd-%i.pid
ExecStart=/usr/sbin/hostapd -B -P /run/hostapd-%i.pid /etc/hostapd/%i.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
