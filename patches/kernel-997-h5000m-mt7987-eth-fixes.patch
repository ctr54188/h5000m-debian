+/* Combined handler used on every MT7987 ethernet interrupt line.  It only
+ * acts when the QDMA/PDMA status really carries a source we own; otherwise
+ * it returns IRQ_NONE so the kernel masks a misbehaving line instead of
+ * spinning on it forever.
+ */
+static irqreturn_t mtk_handle_irq_fe(int irq, void *_eth)
+{
+	struct mtk_eth *eth = _eth;
+	const struct mtk_reg_map *reg_map = eth->soc->reg_map;
+	irqreturn_t ret = IRQ_NONE;
+
+	if ((mtk_r32(eth, reg_map->pdma.irq_mask) &
+	     eth->soc->rx.irq_done_mask) &&
+	    (mtk_r32(eth, reg_map->pdma.irq_status) &
+	     eth->soc->rx.irq_done_mask)) {
+		mtk_handle_irq_rx(irq, _eth);
+		ret = IRQ_HANDLED;
+	}
+
+	if ((mtk_r32(eth, reg_map->tx_irq_mask) & MTK_TX_DONE_INT) &&
+	    (mtk_r32(eth, reg_map->tx_irq_status) & MTK_TX_DONE_INT)) {
+		mtk_handle_irq_tx(irq, _eth);
+		ret = IRQ_HANDLED;
+	}
+
+	if (ret == IRQ_NONE && net_ratelimit())
+		dev_info(eth->dev,
+			 "MT7987 fe irq=%d UNHANDLED pdma_st=0x%08x pdma_msk=0x%08x qtx_st=0x%08x qtx_msk=0x%08x\n",
+			 irq, mtk_r32(eth, reg_map->pdma.irq_status),
+			 mtk_r32(eth, reg_map->pdma.irq_mask),
+			 mtk_r32(eth, reg_map->tx_irq_status),
+			 mtk_r32(eth, reg_map->tx_irq_mask));
+
+	return ret;
+}
+
 static irqreturn_t mtk_handle_irq(int irq, void *_eth)
 {
 	struct mtk_eth *eth = _eth;
